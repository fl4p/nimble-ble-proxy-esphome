# Environment sensors (components/env_sensors): SHT3x on I2C, DS18B20 on
# 1-Wire (RMT). Layer on the PSRAM build, with or without the modbus fragment:
#   idf.py -B build-psram-mb-env -DIDF_TARGET=esp32s3 -DSDKCONFIG=build-psram-mb-env/sdkconfig \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.psram;sdkconfig.defaults.modbus;sdkconfig.defaults.sensors" build
# Pins avoid flash/PSRAM (26-37), straps (0/3/45/46), USB (19/20), console
# (43/44), JTAG (39-42), the modbus bridge (4/5, DE 6) and the DevKit RGB
# LED (38/48). The 1-Wire bus needs an external 4.7 kOhm pull-up to 3V3.
CONFIG_NBP_ENV_SENSORS=y
CONFIG_NBP_ENV_SDA_GPIO=8
CONFIG_NBP_ENV_SCL_GPIO=9
CONFIG_NBP_ENV_OW_GPIO=7
CONFIG_NBP_ENV_PERIOD_S=30
CONFIG_NBP_ENV_DS_MAX=6
# Driver code in flash, not internal RAM (~4.6 KB). Their ISRs are not
# cache-safe either way (masked during flash writes); a 1-Wire transfer hit
# by one fails its CRC and reads null for that cycle.
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
